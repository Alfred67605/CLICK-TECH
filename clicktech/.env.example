# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5544/clicktech?schema=public"

# Secreto de sesiones HTTP-only (generar con: openssl rand -hex 32)
AUTH_SECRET="CHANGE_ME_GENERATE_64_HEX_CHARS"

# URL pública de la aplicación
APP_URL="http://localhost:3000"

# Entorno de demostración (true muestra aviso discreto y habilita cuentas demo)
DEMO_MODE="true"

# Zona horaria operativa
TIMEZONE="America/La_Paz"

# Tiempo de expiración de reservas de stock en minutos
RESERVATION_TTL_MINUTES="30"

# Directorio para comprobantes y adjuntos privados (fuera de /public)
PRIVATE_STORAGE_DIR="./storage/private"

# Adaptador de correo para recuperación de acceso ("local-dev-log" o "smtp")
SMTP_ADAPTER="local-dev-log"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Canal de WhatsApp Business (dejar vacío si aún no hay número oficial configurado)
WHATSAPP_NUMBER=""
